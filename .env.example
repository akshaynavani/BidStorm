# --- Exchange ---
EXCHANGE_TMAX_MS=80
EXCHANGE_OVERHEAD_MS=10
EXCHANGE_AUCTION_TYPE=2
EXCHANGE_DEFAULT_FLOOR=0.10
EXCHANGE_PUBLIC_URL=http://localhost:8000
# Comma-separated name=host:port pairs
EXCHANGE_DSP_ENDPOINTS=dsp-alpha=localhost:50051,dsp-beta=localhost:50052,dsp-gamma=localhost:50053

# --- DMP (Redis) ---
REDIS_URL=redis://localhost:6379/0
DMP_TIMEOUT_MS=5

# --- Kafka ---
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_PREFIX=bidstorm

# --- DSP instance ---
DSP_NAME=dsp-alpha
DSP_PORT=50051
DSP_VALUE_PER_CLICK=1.50
DSP_DAILY_BUDGET=500.0
DSP_TARGET_SEGMENTS=sports,auto
DSP_LATENCY_MS=5
DSP_LATENCY_JITTER_MS=10
DSP_MODEL_PATH=models/ctr.joblib
